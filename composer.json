{
    "name": "dk-product-label/dk-product-label",
    "description": "Assign labels like \"New\" or \"Sale\" to products and show them in the storefront.",
    "type": "shopware-platform-plugin",
    "version": "0.2.0",
    "license": "MIT",
    "authors": [{ "name": "Daniel Kersten" }],
    "require": {
        "shopware/core": "~6.7.0",
        "shopware/storefront": "~6.7.0",
        "shopware/administration": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "Dk\\ProductLabel\\DkProductLabel",
        "label": {
            "de-DE": "Produkt-Labels",
            "en-GB": "Product labels"
        },
        "description": {
            "en-GB": "Assign labels like \"New\" or \"Sale\" to products.",
            "de-DE": "Weise Produkten Labels wie \"Neu\" oder \"Sale\" zu."
        }
    },
    "autoload": {
        "psr-4": {
            "Dk\\ProductLabel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dk\\ProductLabel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "../../../vendor/bin/phpunit",
        "phpstan": "tools/vendor/bin/phpstan analyse --memory-limit=1G",
        "cs-check": "tools/vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "tools/vendor/bin/php-cs-fixer fix"
    }
}
